QWidget { background:#0d1526; color:#d7e0ef; font-family:"Segoe UI"; font-size:14px; }
#sidebar { background:#09111f; border-right:1px solid #1d2b43; }
#brand { color:#f8fafc; font-size:17px; font-weight:700; }
#brandMark { background:#2563eb; border-radius:8px; padding:7px; }
#navSection { color:#64748b; font-size:11px; font-weight:700; letter-spacing:0.8px; padding-left:10px; }
#sidebar QPushButton { color:#9badc4; border:1px solid transparent; border-radius:8px; min-height:26px; padding:9px 10px; text-align:left; }
#sidebar QPushButton:hover:enabled { background:#13223a; color:#f8fafc; }
#sidebar QPushButton[active="true"] { background:#1d4ed8; color:#fff; font-weight:600; }
#sidebar QPushButton:disabled { color:#63738c; }
#sidebar QPushButton[comingSoon="true"]:disabled { border:1px solid #17263d; }
#storageStatus { background:#101c30; border:1px solid #1d304b; border-radius:9px; color:#71829d; }
#storageTitle { color:#34d399; font-weight:600; }
#header { background:#101a2c; border-bottom:1px solid #1d2b43; }
#breadcrumb { color:#91a4bf; }
#phaseTag { background:#1e3a5f; border-radius:5px; color:#7dd3fc; font-size:11px; font-weight:700; padding:5px 8px; }
#title { color:#f8fafc; font-size:27px; font-weight:700; }
#pageTitle { color:#f8fafc; font-size:27px; font-weight:700; }
#projectName { color:#f8fafc; font-size:22px; font-weight:650; }
#detailMeta, #muted { color:#8ea1bb; }
QPushButton { color:#c5d2e5; background:transparent; border:1px solid transparent; border-radius:7px; padding:9px 13px; }
QPushButton:hover:enabled { background:#17263d; color:#fff; }
QPushButton:focus { border:1px solid #60a5fa; }
QPushButton#primary { background:#2563eb; border:1px solid #3b82f6; border-radius:7px; color:#fff; font-weight:650; padding:8px 18px; }
QPushButton#primary:hover:enabled { background:#1d4ed8; border-color:#60a5fa; }
QPushButton#primary:pressed { background:#1e40af; }
QPushButton#secondary { background:#132238; border:1px solid #253956; border-radius:7px; color:#cbd5e1; padding:8px 14px; }
QPushButton#secondary:hover:enabled { background:#1c304d; border-color:#3b82f6; color:#ffffff; }
QPushButton#danger { background:#24141e; border:1px solid #4d1d2b; border-radius:7px; color:#f87171; padding:8px 14px; }
QPushButton#danger:hover:enabled { background:#371926; border-color:#ef4444; color:#ffffff; }
QPushButton#danger:disabled { background:#191218; border-color:#311b22; color:#5c424a; }
QPushButton#back { color:#93c5fd; padding-left:0; }
QScrollArea { background:transparent; }
QScrollBar:vertical { background:#0d1526; width:9px; margin:4px; }
QScrollBar::handle:vertical { background:#31445f; border-radius:4px; min-height:25px; }
#card { background:#14223a; border:1px solid #263a58; border-radius:11px; }
#card:hover { border:1px solid #3b82f6; background:#162741; }
#cardTitle { color:#f8fafc; font-size:17px; font-weight:650; }
#tag { background:#1d3c66; border-radius:5px; color:#93c5fd; font-weight:600; padding:4px 8px; }
#status { color:#34d399; font-weight:600; }
#matrixCount { color:#93c5fd; background:#102544; border:1px solid #26466f; border-radius:5px; padding:4px 7px; font-size:12px; }
#path { color:#aabbd2; background:#101c30; border-radius:6px; padding:8px 10px; }
#emptyState { background:#14223a; border:1px dashed #365170; border-radius:12px; }
#emptyTitle { color:#f8fafc; font-size:18px; font-weight:650; }
QDialog { background:#101b2e; }
#dialogHeader { background:#14233b; border-bottom:1px solid #293e5d; }
#dialogIcon { background:#1d4ed8; border-radius:8px; padding:8px; }
#dialogTitle { color:#f8fafc; font-size:19px; font-weight:700; }
#dialogSubtitle, #fieldHint { color:#8fa3bf; font-size:12px; }
#dialogFooter { background:#14233b; border-top:1px solid #293e5d; }
QFormLayout > QLabel { color:#dbe7f7; font-weight:600; }
QLineEdit, QTextEdit { background:#0c1729; border:1px solid #304766; border-radius:7px; color:#f8fafc; padding:9px 10px; }
QComboBox { background:#0c1729; border:1px solid #304766; border-radius:7px; color:#f8fafc; padding:8px 10px; }
QLineEdit:focus, QTextEdit:focus, QComboBox:focus { border:1px solid #60a5fa; }
#error { color:#fca5a5; background:#3a1f2a; border:1px solid #713342; border-radius:6px; padding:8px 10px; }
#stepActive, #step { background:#14223a; border:1px solid #283e5e; border-radius:10px; min-height:88px; }
#stepActive { border-color:#3b82f6; background:#163158; }
#stepNumberActive, #stepNumber { background:#24354e; border-radius:14px; color:#9fb0c7; font-weight:700; min-width:28px; min-height:28px; max-width:28px; max-height:28px; }
#stepNumberActive { background:#2563eb; color:#fff; }
#stepText { color:#b8c8dd; font-weight:600; }
#detailNotice { background:#13233a; border:1px solid #284365; border-radius:9px; color:#b8cae2; }
#facebookCard { background:#14223a; border:1px solid #284365; border-radius:9px; }
QDialog#facebookComposerDialog { background:#0f1b2d; }
QDialog#facebookComposerDialog #facebookCard { border-radius:8px; }
#facebookSectionTitle { color:#f8fafc; font-size:16px; font-weight:650; }
QFrame#facebookCard QLabel { background:transparent; }
QTableWidget#facebookVideoTable, QTableWidget#facebookJobTable { background:#0c1729; alternate-background-color:#101c30; border:1px solid #284365; color:#d7e0ef; gridline-color:#1c2d46; selection-background-color:#1d3c66; outline:none; }
QTableWidget, QTableView { outline:none; }
QTableWidget::item:focus, QTableView::item:focus { outline:none; border:none; }
QTableWidget#facebookVideoTable::item, QTableWidget#facebookJobTable::item { padding:4px 6px; }
#dropZone { border:2px dashed #304766; border-radius:8px; color:#8ea1bb; background:#0c1729; }
#dropZone:hover { border-color:#3b82f6; color:#d7e0ef; }
#actionStatus { background:#13233a; border:1px solid #284365; border-radius:9px; min-height:48px; }
#actionStatusTitle { color:#f8fafc; font-size:16px; font-weight:700; }
#actionStatusDetail { color:#b8c8dd; }
QTableView#videoTable { background:#0c1729; alternate-background-color:#101c30; border:1px solid #284365; color:#d7e0ef; gridline-color:#1c2d46; selection-background-color:#1d3c66; }
QTableView#videoTable QHeaderView::section { color:#c6d7ee; font-weight:650; padding:10px 9px; }
QTableView#csvPreviewTable { background:#0c1729; alternate-background-color:#101c30; border:1px solid #284365; color:#d7e0ef; gridline-color:#1c2d46; selection-background-color:#1d3c66; }
QTableView#downloadQueueTable { background:#0c1729; alternate-background-color:#101c30; border:1px solid #284365; color:#d7e0ef; gridline-color:#1c2d46; selection-background-color:#1d3c66; }
QTableView#matrixTable { background:#0c1729; border:1px solid #284365; color:#d7e0ef; gridline-color:#1c2d46; selection-background-color:#1d3c66; }
QTableView#projectVideoListTable { background:#0c1729; alternate-background-color:#101c30; border:1px solid #284365; color:#d7e0ef; gridline-color:#1c2d46; selection-background-color:#1d3c66; }
QTableView#projectVideoListTable::item { padding:3px; }
QTabWidget#matrixContentTabs::pane { border:1px solid #243955; border-radius:7px; top:-1px; }
QTabWidget#matrixContentTabs QTabBar::tab { background:#101c30; color:#9fb0c7; border:1px solid #263a58; border-bottom:0; border-top-left-radius:7px; border-top-right-radius:7px; margin-right:5px; padding:8px 14px; }
QTabWidget#matrixContentTabs QTabBar::tab:selected { background:#17345b; color:#f8fafc; border-color:#3b82f6; }
QTabWidget#projectTabs::pane { background:transparent; border:0; }
QTabWidget#projectTabs QTabBar::tab { background:#101c30; color:#9fb0c7; border:1px solid #263a58; border-bottom:0; border-top-left-radius:7px; border-top-right-radius:7px; margin-right:5px; padding:8px 14px; }
QTabWidget#projectTabs QTabBar::tab:selected { background:#17345b; color:#f8fafc; border-color:#3b82f6; }
QTabWidget#projectTabs QTabBar::tab:hover { background:#17263d; }
QTabWidget#facebookTabs::pane { background:transparent; border:0; }
QTabWidget#facebookTabs QTabBar::tab { background:#101c30; color:#9fb0c7; border:1px solid #263a58; border-bottom:0; border-top-left-radius:7px; border-top-right-radius:7px; margin-right:5px; padding:7px 12px; }
QTabWidget#facebookTabs QTabBar::tab:selected { background:#17345b; color:#f8fafc; border-color:#3b82f6; }
QTabWidget#facebookTabs QTabBar::tab:hover { background:#17263d; }
#matrixHeader { background:transparent; border-bottom:1px solid #1d2b43; }
#matrixTabs::tab { background:#101c30; color:#9fb0c7; border:1px solid #263a58; border-radius:7px; margin-right:6px; padding:9px 14px; }
#matrixTabs::tab:selected { background:#17345b; color:#f8fafc; border-color:#3b82f6; }
#matrixTabs::tab:hover { background:#17263d; }
#matrixAddTab { color:#34d399; border:1px dashed #28755f; padding:7px 12px; }
#matrixProgress { background:#18283d; border:0; border-radius:5px; }
#matrixProgress::chunk { background:#10b981; border-radius:5px; }
#matrixEmpty { color:#9fb0c7; background:#101c30; border:1px dashed #365170; border-radius:10px; min-height:180px; }
#matrixListEditor { min-height:75px; }
#csvPreviewErrors { background:#0c1729; border:1px solid #713342; border-radius:6px; color:#fca5a5; }
QHeaderView::section { background:#14223a; color:#8ea1bb; border:1px solid #284365; padding:7px; }
#downloadToastCard { background:#0c192c; border:1px solid #1e3557; border-radius:8px; }
#toastTitle { color:#f8fafc; font-size:13px; font-weight:600; }
#toastProgressLabel { color:#94a3b8; font-size:12px; }
#toastStatsLabel { color:#94a3b8; font-size:12px; }
#toastProgressBar { background:#16263d; border:0; border-radius:2.5px; }
#toastProgressBar::chunk { background:qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #06b6d4, stop:1 #3b82f6); border-radius:2.5px; }
#toastCancelButton { background:#2a151f; border:1px solid #5a1e2b; border-radius:4px; color:#f87171; font-weight:700; font-size:11px; min-width:22px; max-width:22px; min-height:22px; max-height:22px; padding:0; }
#toastCancelButton:hover { background:#431a28; border-color:#ef4444; color:#ffffff; }
